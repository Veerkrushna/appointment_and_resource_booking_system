# Multi-stage Dockerfile for React + Vite Frontend

# Stage 1: Build the application using Node.js
FROM node:22-alpine AS builder

# Set the working directory inside the container
WORKDIR /app

# Copy package dependency definitions
COPY package.json package-lock.json ./

# Install project dependencies
RUN npm ci

# Copy the rest of the frontend source code
COPY . .

# Build the production bundle into the /app/dist directory
RUN npm run build

# Stage 2: Serve the production build using lightweight Nginx
FROM nginx:alpine

# Remove default nginx static assets and configuration
RUN rm -rf /etc/nginx/conf.d/default.conf

# Copy custom Nginx configuration for React SPA routing & backend reverse-proxy
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy production static assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 80 to receive web traffic
EXPOSE 80

# Start Nginx in foreground mode
CMD ["nginx", "-g", "daemon off;"]
