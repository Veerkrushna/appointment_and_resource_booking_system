# =========================
# Application
# =========================
APP_NAME=your_app_name
ENVIRONMENT=your_environment
DEBUG=your_debug_mode

# =========================
# Backend
# =========================
BACKEND_HOST=your_backend_host
BACKEND_PORT=your_backend_port

# =========================
# PostgreSQL
# =========================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_postgres_db
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=your_postgres_port
DATABASE_URL=postgresql+psycopg://your_postgres_user:your_password@your_postgres_host:your_postgres_port/your_postgres_db

# =========================
# Redis & Celery
# =========================
REDIS_URL=redis://your_redis_host:your_redis_port/0
CELERY_RESULT_BACKEND=redis://your_redis_host:your_redis_port/1

# =========================
# Razorpay (Test Mode)
# =========================
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# =========================
# Mail / SMTP
# =========================
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port
SMTP_FROM=your_smtp_from_email
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_app_password
SMTP_STARTTLS=your_smtp_starttls
